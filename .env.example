# .env.example — Variables de entorno esperadas (SPEC-001 §11, ADR-04 §2.2).
# Este archivo NO contiene valores reales. Frank los provisiona operativamente.
# Las claves con valores vacíos o ausentes harán fallar `pnpm deps:check` con
# mensaje que nombra la variable faltante (nunca su valor).

# ── Aplicación ──────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"

# ── Base de datos (PostgreSQL 16) ───────────────────────────────────────────
# Formato: postgres://USER:PASS@HOST:PORT/DB
DATABASE_URL=""

# ── Cifrado (ADR-03) ────────────────────────────────────────────────────────
# 32 bytes en base64 (AES-256). Para rotación, añadir MASTER_KEY_V2, V3...
MASTER_KEY=""
MASTER_KEY_VERSION="1"

# ── Sesión / JWT (ADR-06) ───────────────────────────────────────────────────
# >=32 bytes. Usar openssl rand -base64 32
SESSION_SECRET=""

# ── Almacenamiento S3-compatible (MinIO en dev) ─────────────────────────────
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# ── Bootstrap / primer Director (ADR-04 §2.3) ───────────────────────────────
VECTORIA_DIRECTOR_EMAIL=""
VECTORIA_ORG_NAME="Vector IA"

# ── Locks (ADR-03 §3.3, AC-21) ──────────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS="5"
LOCKOUT_WINDOW_MINUTES="15"

# ── Cookies (ADR-06 §2.1) ───────────────────────────────────────────────────
COOKIE_SECURE="false" # true en prod (HTTPS)

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
