flowchart TB
    subgraph INICIO["Pantalla de inicio"]
        HOY["HOY<br/>Lo importante del día"]
    end

    subgraph BUSQUEDA["Búsqueda global (lupa)"]
        SEARCH["Cualquier cosa:<br/>cliente, factura, monto,<br/>nombre, fecha"]
    end

    subgraph MENU["Menú (3 entradas)"]
        CLIENTES["CLIENTES"]
        FACTURAS["FACTURAS"]
        HOY2["HOY"]
    end

    subgraph CLIENTE["Timeline del Cliente (sin tabs)"]
        ESPEC["📋 Spec firmada<br/>(propuesta técnica)"]
        COT["💼 Cotización<br/>1 línea + monto + propuesta"]
        OS["📄 Orden de Servicio"]
        PROY["🏗️ Proyecto<br/>(estado + hitos + tareas)"]
        FACTS["🧾 Facturas<br/>(anticipo + hitos + final)"]
        CUENTAS["💰 Cuentas por cobrar"]
        BITACORA["📒 Bitácora"]
        CAMBIOS["🔄 Cambios de alcance<br/>(adicional / hito nuevo / proyecto aparte)"]
    end

    subgraph PROYECTO["Detalle del Proyecto"]
        HITO["Hitos<br/>(de spec firmada + adicionales)"]
        TAREAS["Tareas<br/>(programador, evidencia, horas opcionales)"]
        ENTRE["Entregables<br/>(links, archivos, capturas)"]
        BITAT["Bitácora técnica<br/>(notas por tarea)"]
    end

    subgraph COBRANZA["Cuentas múltiples"]
        BCO["Banco<br/>(Banorte, BBVA...)"]
        CAJA["Caja chica / Efectivo"]
        DIG["Digital<br/>(MercadoPago, Stripe)"]
        TC["Tarjeta corporativa"]
    end

    subgraph EQUIPO["Equipo"]
        PERS["Personas<br/>(las 4 + costo-hora)"]
        COM["Comisiones calculadas<br/>(al pagar factura)"]
    end

    subgraph BACK["Configuración (engranaje)"]
        CFG["Emisor fiscal<br/>+ Claves SAT<br/>+ PAC"]
    end

    HOY --> CLIENTES
    HOY --> FACTURAS
    SEARCH --> CLIENTE
    SEARCH --> FACTURAS

    CLIENTES --> CLIENTE

    ESPEC -->|"vN firmada"| COT
    COT -->|"aprobada"| OS
    OS -->|"firmada"| PROY

    PROY --> HITO
    HITO --> TAREAS
    TAREAS --> ENTRE
    TAREAS --> BITAT

    HITO -->|"cerrado"| FACTS
    OS -->|"anticipo"| FACTS

    FACTS -->|"timbrada"| CFG
    FACTS -->|"pagada"| COBRANZA
    FACTS -->|"pagada"| COM

    PROY -->|"cambio solicitado"| CAMBIOS
    CAMBIOS -->|"adicional"| COT
    CAMBIOS -->|"grande"| CLIENTES

    BITACORA -.->|"notas"| CLIENTE

    COBRANZA --> BCO
    COBRANZA --> CAJA
    COBRANZA --> DIG
    COBRANZA --> TC
