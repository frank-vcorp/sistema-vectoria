{
  "name": "vectoria-provision",
  "version": "2.0.0",
  "private": true,
  "description": "Runner one-shot CLI for idempotent Coolify provisioning. v2.0 baseline reusable multi-proyecto (SPEC-20260821-001 + ADR-20260821-01).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vectoria-provision": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "node --test --import tsx 'tests/*.test.ts' 'tests/e2e/*.test.ts' 'tests/contract/**/*.test.ts' 'tests/preflight/*.test.ts' 'tests/triggers/*.test.ts' 'tests/runtime-adapter/*.test.ts' 'tests/ensure/*.test.ts' 'tests/push/*.test.ts'",
    "test:lock": "node --test --import tsx tests/lock.test.ts",
    "test:e2e:multi-project": "node --test --import tsx tests/e2e/multi-project-disposable.test.ts tests/e2e/conflict-disposable.test.ts tests/e2e/cross-project-v2.test.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}